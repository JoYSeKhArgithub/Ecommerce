<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap');
        
        body {
            margin: 0;
            padding: 0;
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            line-height: 1.6;
        }
        
        .container {
            max-width: 600px;
            margin: 40px auto;
            padding: 0 20px;
        }
        
        .card {
            background-color: #ffffff;
            border-radius: 24px;
            padding: 48px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }
        
        .logo-section {
            text-align: center;
            margin-bottom: 32px;
        }
        
        .logo-placeholder {
            font-size: 28px;
            font-weight: 700;
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.025em;
        }
        
        h1 {
            font-size: 24px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 16px;
            color: #0f172a;
        }
        
        p {
            font-size: 16px;
            color: #475569;
            margin-bottom: 24px;
            text-align: center;
        }
        
        .otp-container {
            background-color: #f1f5f9;
            border-radius: 16px;
            padding: 24px;
            text-align: center;
            margin: 32px 0;
            border: 1px dashed #cbd5e1;
        }
        
        .otp-code {
            font-size: 42px;
            font-weight: 700;
            letter-spacing: 12px;
            color: #6366f1;
            margin: 0;
            padding-left: 12px; 
        }
        
        .footer {
            text-align: center;
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid #f1f5f9;
            font-size: 14px;
            color: #94a3b8;
        }
        
        .expiry-notice {
            font-weight: 600;
            color: #ef4444;
            display: block;
            margin-top: 8px;
        }
        
        .divider {
            height: 1px;
            background: #f1f5f9;
            margin: 32px 0;
        }

        @media screen and (max-width: 480px) {
            .card {
                padding: 32px 20px;
            }
            .otp-code {
                font-size: 32px;
                letter-spacing: 8px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="logo-section">
                <div class="logo-placeholder">ECOMMERCE</div>
            </div>
            
            <h1>Verify your account</h1>
            <p>Hi <strong><%= name %></strong>,</p>
            <p>Thank you for choosing our platform. To complete your registration and activate your account, please use the verification code below:</p>
            
            <div class="otp-container">
                <div class="otp-code"><%= otp %></div>
            </div>
            
            <p>
                This code is valid for a limited time.
                <span class="expiry-notice">Expires in 5 minutes</span>
            </p>
            
            <div class="divider"></div>
            
            <p style="font-size: 14px; margin-bottom: 0;">If you didn't request this code, you can safely ignore this email.</p>
            
            <div class="footer">
                &copy; 2024 Ecommerce Inc. All rights reserved.<br>
                123 Commerce Way, Digital City, 54321
            </div>
        </div>
    </div>
</body>
</html>
